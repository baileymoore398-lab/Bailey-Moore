# ---------------------------------------------------------------------------
# PrintForge NZ — environment configuration
# Copy to .env and fill in. The platform runs fully with just DATABASE_URL +
# AUTH_SECRET; every other integration has a safe local fallback until keys
# are provided.
# ---------------------------------------------------------------------------

# Database (PostgreSQL) — required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/printforge?schema=public"

# Session signing secret — required (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-in-production"

# Public site URL (used for SEO metadata + reset links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Authentication (Clerk) — optional. Without these, built-in email/password
#     auth is used. With them you can enable Google + Apple social login. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Payments (Stripe) — optional. Without a key, a mock PaymentIntent is
#     returned so checkout is demoable. ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- AI Design Assistant (OpenAI) — optional. Falls back to a rules engine. ---
OPENAI_API_KEY=
OPENAI_MODEL="gpt-4o-mini"

# --- Storage (AWS S3) — optional. Without these, uploads are processed
#     in-memory for quoting and referenced by a local key. ---
AWS_S3_BUCKET=
AWS_REGION="ap-southeast-2"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Shipping carriers — optional. Without keys, realistic mock tracking
#     numbers are generated. ---
NZ_POST_API_KEY=
ARAMEX_NZ_API_KEY=
COURIER_POST_API_KEY=

# --- Email / notifications ---
ADMIN_EMAIL="admin@printforge.nz"
