# =============================================================================
# RouteForge — environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# The `.env` file is consumed by docker-compose and (in dev) by the backend.
# All values below are SAFE DUMMY DEFAULTS suitable for local development only.
# NEVER commit a real `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Core / runtime
# -----------------------------------------------------------------------------
ENV=development                 # development | staging | production
LOG_LEVEL=info                  # debug | info | warning | error

# -----------------------------------------------------------------------------
# PostgreSQL
# These POSTGRES_* values are read by the `db` service in docker-compose.
# DATABASE_URL is what the backend / alembic actually use to connect.
# Host is `db` (the compose service name) inside the Docker network.
# -----------------------------------------------------------------------------
POSTGRES_USER=routeforge
POSTGRES_PASSWORD=routeforge
POSTGRES_DB=routeforge
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://routeforge:routeforge@db:5432/routeforge

# -----------------------------------------------------------------------------
# Redis / Celery
# Redis is the Celery broker and result backend. Host `redis` inside compose.
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -----------------------------------------------------------------------------
# Object storage (S3 / MinIO)
# In local dev these point at the `minio` compose service. In production set
# them to real AWS S3 (or any S3-compatible provider) credentials.
# S3_PUBLIC_URL is the externally reachable base URL used to build asset links.
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_BUCKET=routeforge
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_URL=http://localhost:9000/routeforge
# Credentials used to bootstrap the local MinIO server (compose only).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# AI / LLM
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-dummy-replace-me

# -----------------------------------------------------------------------------
# Auth / security
# JWT_SECRET signs first-party tokens. Generate a strong value for production:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Clerk keys are OPTIONAL — only required if Clerk-based auth is enabled.
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-dev-only-do-not-use-in-production

# -----------------------------------------------------------------------------
# Memberships master switch.
# -----------------------------------------------------------------------------
# OFF by default: even with Stripe/PayPal keys + Plan IDs configured below,
# the membership page stays "coming soon" and everything is free & unlimited.
# Set MEMBERSHIPS_ENABLED=true (on the API service, then redeploy) to show the
# buy buttons and start enforcing the free-plan limit. Set back to false to
# turn selling off again — your keys stay configured, nothing is lost.
MEMBERSHIPS_ENABLED=false

# -----------------------------------------------------------------------------
# Billing (Stripe) — OPTIONAL, required only for paid features.
# -----------------------------------------------------------------------------
# Memberships stay in "coming soon" preview mode until STRIPE_SECRET_KEY is
# set; then the Upgrade buttons go live automatically. To enable:
#   1. Create a Stripe account (stripe.com) and add your payout/bank details.
#   2. In Stripe → Product catalogue, create a Product per paid tier (Pro,
#      Team, Club) with a recurring monthly Price; copy each price_… ID.
#   3. Set the four vars below on the API service and redeploy.
#   4. (Recommended) Add a webhook endpoint in Stripe pointing at
#      <backend>/api/v1/billing/webhook and set STRIPE_WEBHOOK_SECRET.
STRIPE_SECRET_KEY=sk_test_dummy
STRIPE_WEBHOOK_SECRET=whsec_dummy
STRIPE_PRICE_PRO=price_dummy_pro
STRIPE_PRICE_TEAM=price_dummy_team
STRIPE_PRICE_CLUB=price_dummy_club

# -----------------------------------------------------------------------------
# Billing (PayPal) — OPTIONAL alternative to Stripe.
# -----------------------------------------------------------------------------
# Memberships stay "coming soon" until PAYPAL_CLIENT_ID + PAYPAL_SECRET are set;
# then PayPal subscription buttons appear for any tier that has a Plan ID.
#   1. developer.paypal.com → Apps & Credentials → create a REST app; copy the
#      Client ID + Secret. Use the "Sandbox" ones first (PAYPAL_ENV=sandbox).
#   2. Create a subscription Plan per paid tier: in the PayPal dashboard make a
#      Product, then a monthly Plan for Pro / Team / Club; copy each Plan ID
#      (looks like P-XXXXXXXXXXXX) into the vars below.
#   3. Set these on the API service; ALSO set NEXT_PUBLIC nothing — the client
#      id is delivered to the frontend via /billing/plans automatically.
#   4. Test end-to-end in sandbox, then switch PAYPAL_ENV=live with live keys.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_TEAM=
PAYPAL_PLAN_CLUB=

# -----------------------------------------------------------------------------
# Activity provider integrations (OAuth) — OPTIONAL.
#
# Strava ("connect Strava → pick an activity → analyze"):
#   1. Go to https://www.strava.com/settings/api and create an app (free).
#      - Category: Data Importer.  Website: your frontend URL.
#      - Authorization Callback Domain: your BACKEND host only, no scheme/path,
#        e.g.  routeforge-api-production.up.railway.app
#   2. Copy the Client ID and Client Secret into the two vars below (on Railway,
#      set them on the API service) and redeploy.
#   3. FRONTEND_URL (above) must be set — the OAuth callback redirects there.
# The Connect Strava button appears automatically once these are set.
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Email (transactional) — OPTIONAL but needed for real welcome / password-reset
# emails. Leave SMTP_HOST blank to disable sending (emails are logged, and the
# reset token is returned in the API response outside production).
#
# Transport priority: Resend (if RESEND_API_KEY set) → SMTP → log-only.
#
# Option A — Resend (recommended for cloud hosts; https://resend.com):
#   1. Sign up, create an API key.
#   2. Set RESEND_API_KEY below. For testing you can send from the shared
#      onboarding@resend.dev address (leave EMAIL_FROM blank) — note it only
#      delivers to your own account email until you verify a domain.
#   3. To send from your own address, verify a domain in Resend and set
#      EMAIL_FROM=hello@yourdomain.
#
# Option B — Gmail SMTP: create a Google "App password" (Account → Security →
# 2-Step Verification → App passwords) and use it as SMTP_PASSWORD.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=route.forge.official@gmail.com
#   SMTP_PASSWORD=your-16-char-app-password
#   EMAIL_FROM=route.forge.official@gmail.com
#
# FRONTEND_URL is used to build links in emails (e.g. the password-reset link),
# so set it to your deployed site URL.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=
EMAIL_FROM_NAME=RouteForge
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend
# NEXT_PUBLIC_* vars are baked into the browser bundle at build time.
# Point this at the public base URL of the backend (the frontend appends
# /api/v1). Behind the bundled nginx proxy use http://localhost:8080.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# CORS / rate limiting
# CORS_ORIGINS is a comma-separated allow-list of browser origins.
# CORS_ORIGIN_REGEX additionally allows matching origins — handy for Vercel
# preview deploys, e.g. https://.*\.vercel\.app
# RATE_LIMIT_DEFAULT is the per-client ceiling on every endpoint (slowapi
# syntax). RATE_LIMIT_STORAGE_URI, when set to your Redis URL, shares limits
# across API instances; blank = in-memory per process. RATE_LIMIT_ENABLED=false
# turns limiting off entirely.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ORIGIN_REGEX=
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=

# -----------------------------------------------------------------------------
# Admin & misc
# ADMIN_EMAILS: comma-separated emails granted admin (feedback dashboard etc.).
# MUST be set in production — leave blank and nobody is admin.
# -----------------------------------------------------------------------------
ADMIN_EMAILS=
OPENAI_MODEL=gpt-4o-mini
FREE_PLAN_MONTHLY_ANALYSES=5
LOCAL_STORAGE_DIR=./storage_data
CELERY_CONCURRENCY=2
# Run analysis inline (no broker) — true for local dev; MUST be false in
# production so the API doesn't block on the heavy pipeline.
CELERY_TASK_ALWAYS_EAGER=true
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Observability (optional) — set SENTRY_DSN to enable error tracking.
# -----------------------------------------------------------------------------
SENTRY_DSN=
