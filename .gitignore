*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
.eggs/
*.egg-info/
*.egg
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.hypothesis/

# ---- Node / Next.js ---------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Docker -----------------------------------------------------------------
docker-compose.override.yml
*.local.yml

# ---- Media / uploads / generated assets -------------------------------------
/uploads/
/media/
/storage/
/data/
*.mp4
*.mov
*.gpx.bak
backend/uploads/
backend/media/

# ---- ML weights / large artifacts -------------------------------------------
