*.pth
*.onnx
*.weights
models/weights/

# ---- IDE / editors ----------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.fleet/

# ---- OS ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Logs / misc ------------------------------------------------------------
*.log
logs/
tmp/
.cache/

# Runtime artifacts (local storage fallback + sqlite dev DBs)
backend/storage_data/
storage_data/
*.db
*.sqlite
*.sqlite3
