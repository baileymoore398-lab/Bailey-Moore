# =============================================================================
# RouteForge — PRODUCTION environment template
# -----------------------------------------------------------------------------
# Copy to your hosting provider's secret manager (Railway/Render/Vercel/AWS).
# NEVER commit real production secrets. Generate strong random values.
# =============================================================================

# --- Core ---
ENV=production
LOG_LEVEL=info

# --- Database (managed Postgres connection string) ---
# Must use the psycopg2 driver to match the installed package.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/routeforge

# --- Redis / Celery (managed Redis) ---
REDIS_URL=rediss://HOST:6379/0
CELERY_BROKER_URL=rediss://HOST:6379/1
CELERY_RESULT_BACKEND=rediss://HOST:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- Security ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Comma-separated allowed origins (your Vercel domain).
CORS_ORIGINS=https://app.routeforge.example

# --- Object storage (AWS S3 or compatible) ---
S3_ENDPOINT=
S3_BUCKET=routeforge-prod
S3_REGION=eu-north-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
S3_PUBLIC_URL=https://routeforge-prod.s3.eu-north-1.amazonaws.com

# --- AI (optional; rule-based fallback runs without it) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Billing (optional; endpoints return 503 until set) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_CLUB=

# --- Integrations (optional) ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Quotas ---
FREE_PLAN_MONTHLY_ANALYSES=3

# --- Frontend (set in Vercel project env, NOT here) ---
# NEXT_PUBLIC_API_URL=https://api.routeforge.example
